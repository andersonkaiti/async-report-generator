{
  "$schema": "https://www.schemastore.org/tsconfig",
  "_version": "24.0.0",

  "compilerOptions": {
    "lib": [
      "es2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise"
    ],
    "module": "nodenext",
    "target": "es2024",
    "types": ["node", "aws-lambda"],

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node16",

    "allowImportingTsExtensions": true,
    "noEmit": true,

    "paths": {
      "@/*": ["./src/*"],
      "@clients/*": ["./src/clients/*"],
      "@database/*": ["./src/database/*"],
      "@factories/*": ["./src/factories/*"],
      "@functions/*": ["./src/functions/*"],
      "@shared/*": ["./src/shared/*"],
      "@storage/*": ["./src/storage/*"],
      "@app-types/*": ["./src/types/*"]
    }
  }
}
